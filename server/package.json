{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "nodemon --exec \"node --env-file=.env\" server.js",
    "env:setup": "node -e \"const fs=require('fs'); if(!fs.existsSync('.env') && fs.existsSync('.env.example')){ fs.copyFileSync('.env.example', '.env'); console.log('.env created from .env.example'); }\"",
    "db:setup": "npx prisma generate && npx prisma db push",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.16.0",
    "@prisma/client": "^6.19.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^9.1.0",
    "nodemon": "^3.1.0",
    "prisma": "^6.19.0"
  }
}
