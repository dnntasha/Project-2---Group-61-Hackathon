DATABASE_URL="file:./dev.db"
# npm run install:all replaces this with a random secret
JWT_SECRET="replace-with-a-long-random-string"
# Must match the port the client proxies to (scripts/dev.mjs sets it too)
PORT=5000
# Python execution runs inside a Docker container (see README, "Docker").
ENABLE_PYTHON_EXECUTION=true
# Team submissions and grading (POST /api/submit). Off until the UI uses it.
ENABLE_SUBMISSION_GRADING=true
