{
  "name": "group-61-rw343-project-2",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "install:all": "npm install --no-fund --no-audit && npm install --prefix server --no-fund --no-audit && npm install --prefix client --no-fund --no-audit && npm run setup:backend",
    "setup:backend": "npm run --prefix server env:setup && npm run --prefix server db:setup",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "client/src/**/*.{js,jsx}": [
      "prettier --write",
      "eslint --fix --quiet --config client/eslint.config.js"
    ],
    "server/**/*.{js,mjs}": [
      "prettier --write",
      "eslint --fix --quiet --config server/eslint.config.js"
    ],
    "*.{json,md,yml,css}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git@git.cs.sun.ac.za:Computer-Science/rw334/2026/projects/project-2/group-61-rw343-project-2.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.20.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.9"
  }
}
